# Copy this file to .env and fill in real values. .env is already gitignored —
# never commit real keys. main.py loads .env automatically via python-dotenv.

# --- Model provider key (only ONE needed, matching config/settings.yaml's model.api_key_env) ---
NVIDIA_API_KEY=nvapi-...        # https://build.nvidia.com/settings/api-keys
# GROQ_API_KEY=gsk_...          # https://console.groq.com/keys
# GOOGLE_API_KEY=...            # https://aistudio.google.com/apikey

# --- LangSmith tracing (local monitoring — see graph/build_graph.py, agents/utils.py) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...   # https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_PROJECT=mle-agent-dev
